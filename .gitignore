# Operating system junk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editors and IDEs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*~

# Node tooling (the site itself ships zero runtime dependencies)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/
.pnpm-store/

# Python helpers used for local serving
__pycache__/
*.py[cod]
.venv/
venv/

# Environment and secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Build, coverage and test output
dist/
build/
out/
coverage/
.playwright/
test-results/
*.log

# Local screenshots and scratch files
/tmp/
/screenshots/local/
*.local.html
